{
  "name": "vue-rgrid",
  "version": "1.0.0",
  "author": {
    "name": "Ihoshyn Roman",
    "email": "igoshin18@gmail.com"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "repository": {
    "url": "https://github.com/MasterRO94/vue-rgrid"
  },
  "main": "./dist/vue-rgrid.umd.cjs",
  "module": "./dist/vue-rgrid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-rgrid.js",
      "require": "./dist/vue-rgrid.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "object-hash": "^3.0.0"
  },
  "devDependencies": {
    "@types/object-hash": "^3.0.6",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}
